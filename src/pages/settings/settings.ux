    margin-top: 6px;
  }

  .danger-style {
    background-color: #e74c3c;
  }

  .action-txt {
    font-size: 22px;
    color: #ffffff;
    font-weight: bold;
  }

  /* ========== 每日数量步进器 ========== */
  .stepper {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 10px;
  }
  .step-btn {
    width: 30%;
    height: 60px;
    border-radius: 12px;
    background-color: #2c3e50;
    justify-content: center;
    align-items: center;
  }
