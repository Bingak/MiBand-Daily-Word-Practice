    justify-content: center;
    align-items: center;
  }
  .step-value-txt {
    font-size: 26px;
    color: #ffffff;
    font-weight: bold;
  }

  .row-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .small-switch {
    width: 60px;
    height: 34px;
  }
  .switch-label {
    font-size: 24px;
    color: #ffffff;
    font-weight: bold;
  }
  .small-switch {
  /* 缩小到原来的 0.75 倍 */
  transform: scale(0.75); 
  transform-origin: center right; 
}

  /* ========== 信息卡片 ========== */
  .info-card {
    width: 100%;
    background-color: #1a1a1a;
    border-radius: 14px;
    padding: 20px;
    flex-direction: column;
    margin-bottom: 10px;
  }

  .info-header {
    font-size: 21px;
    color: #aaaaaa;
    margin-bottom: 10px;
  }

  .sub-text {
    font-size: 18px;
    color: #7f8c8d;
    margin-bottom: 4px;
  }
</style>

<script>
  import router from '@system.router';
  import storage from '@system.storage';
  import prompt from '@system.prompt';
  import brightness from '@system.brightness';

  // ===== 每日背诵数量配置（与 learn.ux 保持一致）=====
  const KEY_DAILY = 'daily_word_count';
  const DAILY_DEFAULT = 50;
  const DAILY_MIN = 10;
  const DAILY_MAX = 200;
  const DAILY_PRESETS = [20, 50, 100, 200];

  // 范围校验：越界钳制，非法值回落默认
  const normalizeDaily = (val) => {
    const n = parseInt(val, 10);
    if (isNaN(n)) return DAILY_DEFAULT;
    if (n < DAILY_MIN) return DAILY_MIN;
    if (n > DAILY_MAX) return DAILY_MAX;
    return n;
  };

  export default {
  
    private: {
      currentTime: '00:00', 
      timer: null,
      keepScreenOn: false,
      dailyCount: DAILY_DEFAULT,
    },
  onReady() {
    this.updateTime();          // 立即显示一次
    this.timer = setInterval(() => {
      this.updateTime();
    }, 1000);                   // 每秒刷新
  },
  onHide() {
    if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  },
  updateTime() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    this.currentTime = `${h}:${m}`;
  },

    onInit() {
      // 读取存储的常亮状态
      storage.get({
        key: 'keep_screen_on',
        success: (data) => {
          this.keepScreenOn = data === 'true';
          // 恢复之前的常亮设置
          brightness.setKeepScreenOn({
            keepScreenOn: this.keepScreenOn,
            fail: (err) => {
              console.log('恢复常亮状态失败:', err);
            }
          });
        },
        fail: () => {
          this.keepScreenOn = false;
        }
      });

      // 读取每日背诵数量
      storage.get({
        key: KEY_DAILY,
        success: (data) => {
          const n = normalizeDaily(data);
          this.dailyCount = n;
          // 读到越界或非法值时，顺手修正回合法范围
          if (String(n) !== String(data)) {
            this.persistDaily(n, true);
          }
        },
        fail: () => {
          this.dailyCount = DAILY_DEFAULT;
        }
      });
    },

    goBack() {
      router.back();
    },

    // ====== 每日背诵数量 ======
    changeDaily(delta) {
      let next = this.dailyCount + delta;
      if (next < DAILY_MIN) {
        next = DAILY_MIN;
        prompt.showToast({ message: `最少 ${DAILY_MIN} 个` });
      } else if (next > DAILY_MAX) {
        next = DAILY_MAX;
        prompt.showToast({ message: `最多 ${DAILY_MAX} 个` });
      }
      if (next === this.dailyCount) return;
      this.dailyCount = next;
      this.persistDaily(next);
    },

    // 点击数字弹出常用档位
    showDailyPresets() {
      const buttons = [];
      for (let i = 0; i < DAILY_PRESETS.length; i++) {
        buttons.push({ text: String(DAILY_PRESETS[i]), color: '#3498db' });
      }
      buttons.push({ text: '取消', color: '#888888' });

      prompt.showDialog({
        title: '每日背诵数量',
        message: `当前 ${this.dailyCount} 个，可选范围 ${DAILY_MIN} ~ ${DAILY_MAX}`,
        buttons: buttons,
        success: (data) => {
          if (data && data.index >= 0 && data.index < DAILY_PRESETS.length) {
            this.dailyCount = DAILY_PRESETS[data.index];
            this.persistDaily(this.dailyCount);
          }
        }
      });
    },

    // 持久化保存；silent=true 时不弹提示
    persistDaily(val, silent) {
      storage.set({
        key: KEY_DAILY,
        value: String(val),
        success: () => {
          if (!silent) {
            prompt.showToast({ message: `已设为每日 ${val} 个`, duration: 1200 });
          }
        },
        fail: () => {
          prompt.showToast({ message: '保存失败，请重试', duration: 1500 });
        }
      });
    },

    // ====== 屏幕常亮开关 ======
    onKeepScreenOnChange(e) {
      const newState = e.checked;
      this.keepScreenOn = newState;

      brightness.setKeepScreenOn({
        keepScreenOn: newState,
        success: () => {
          console.log('屏幕常亮设置成功:', newState);
          storage.set({
            key: 'keep_screen_on',
            value: String(newState),
            fail: (err) => {
              console.log('存储常亮状态失败:', err);
            }
          });
        },
        fail: (data, code) => {
          console.log('设置屏幕常亮失败:', data, code);
          prompt.showToast({
            message: '设置失败，请重试',
            duration: 1500
          });
          this.keepScreenOn = !newState;
        }
      });
    },

    // ====== 清除数据（双重确认） ======
    startClearConfirmation() {
      prompt.showDialog({
        title: '警告',
        message: '你确定要清除本地所有的统计和缓存吗？此操作不可回退！',
        buttons: [
          { text: '确认', color: '#ff3333' },
          { text: '取消', color: '#888888' }
        ],
        success: (data) => {
          if (data.index === 0) {
            prompt.showDialog({
              title: '二次核验确认',
              message: '再次确认：清空后所有熟知名单和7天统计图将归零。',
              buttons: [
                { text: '确认', color: '#ff3333' },
                { text: '取消', color: '#888888' }
              ],
              success: (secData) => {
                if (secData.index === 0) {
                  this.wipeAllPracticeRecords();
                }
              }
            });
          }
        }
      });
    },

    wipeAllPracticeRecords() {
      const allWipeKeys = ['vocab_familiar_words', 'vocab_global_stats', 'vocab_today_save'];
      let errorOccurred = false;
      let deleteCount = 0;

      allWipeKeys.forEach(k => {
        storage.delete({
          key: k,
          success: () => {
            deleteCount++;
            if (deleteCount === allWipeKeys.length && !errorOccurred) {
              prompt.showToast({ message: '清除完毕', duration: 1500 });
            }
          },
          fail: () => {
            errorOccurred = true;
          }
        });
      });
    }
  }
</script>