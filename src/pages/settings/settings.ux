<template>
  <div class="page">
    <scroll scroll-y="true" class="page-scroll">
      <div class="container">
        
        <div class="header">
          <text class="back" @click="goBack">返回</text>
          <text class="header-time">{{ currentTime }}</text>
          <text class="title">系统设置</text>
        </div>

        <div class="settings-card">
          <text class="card-title">每日背诵数量</text>
          <div class="stepper">
            <div class="step-btn" @click="changeDaily(-10)">
              <text class="step-txt">－</text>
            </div>
            <div class="step-value" @click="showDailyPresets">
              <text class="step-value-txt">{{ dailyCount }}</text>
            </div>
            <div class="step-btn" @click="changeDaily(10)">
              <text class="step-txt">＋</text>
            </div>
          </div>
          <text class="card-desc">可设范围 10 ~ 200 个，步长 10。点击数字可快速选择常用档位。今天尚未开始背诵时，修改后立即生效。</text>
        </div>

        <div class="settings-card">
          <text class="card-title">清除数据</text>
          <text class="card-desc">清除所有统计和进度。</text>
          <div class="action-btn danger-style" @click="startClearConfirmation">
            <text class="action-txt">清空数据</text>
          </div>
        </div>

        <div class="settings-card">
          <div class="row-item">
            <text class="switch-label">屏幕常亮</text>
            <switch class="small-switch" checked="{{ keepScreenOn }}" @change="onKeepScreenOnChange"></switch>
          </div>
          <text class="card-desc">开启后，屏幕将保持常亮状态。</text>
        </div>

        <div class="info-card">
          <text class="info-header">详细信息</text>
          <text class="sub-text">机型: 小米手环 9 Pro</text>
          <text class="sub-text">版本号v1.0.0</text>
        </div>

      </div>
    </scroll>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }
  .page-scroll {
    width: 100%;
    flex-direction: column;
    flex: 1;
  }

  .container {
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 20px 18px 60px 18px;
  }

  .header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: transparent;
    border-width: 0px; 
    margin-bottom: 25px;
    padding-top: 10px;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: #222222;
  }
  .header-time {
    position: absolute;
    left: 50px;
    width: 182px;
    height: 32px;
    opacity: 1;
    font-size: 22px;
    font-weight: 600;
    line-height: 34px; 
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }
