    width: 100%;
    height: 100%;
    background-color: #000000;
    flex-direction: column;
  }
  .container {
    flex-direction: column;
    align-items: center;
    width: 336px;
    padding: 20px 18px 40px 18px;
    flex-shrink: 0;
  }
  .report-box {
    flex-shrink: 0;
  }
  .header {
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }
  .header-time {
    position: absolute;
    left: 50px;
    width: 182px;
    height: 32px;
    opacity: 1;
    font-size: 23px;
    font-weight: 600;
    line-height: 34px; 
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }
  .back-btn {
    font-size: 24px;
    color: #3498db;
    font-weight: bold;
    padding: 5px 10px;
  }
  .title {
    font-size: 24px;
    color: #ffffff;
    font-weight: bold;
  }
  .learn-region {
    width: 100%;
    flex-direction: column;
  }
  .progress-bar {
    width: 100%;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .progress-txt {
    font-size: 20px;
    color: #aaaaaa;
  }
  .word-card {
    width: 100%;
    background-color: #1a1a1a;
    border-radius: 16px;
    padding: 25px 20px;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
  }
